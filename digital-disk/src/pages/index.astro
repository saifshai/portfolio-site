---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const projects = (await getCollection("projects")).sort(
	(a, b) => a.data.order - b.data.order,
);
const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const formatDate = (value) =>
	value.toLocaleDateString("en-CA", { dateStyle: "medium" });

const quickLinks = [
	{
		label: "Email",
		value: "sshai072@uottawa.ca",
		href: "mailto:sshai072@uottawa.ca",
		icon: "email",
	},
	{
		label: "GitHub",
		value: "@saifshai",
		href: "https://github.com/saifshai",
		icon: "github",
	},
	{
		label: "LinkedIn",
		value: "saifullah-shaikh",
		href: "https://www.linkedin.com/in/saifullah-shaikh-uottawa",
		icon: "linkedin",
	},
];

const work = [
	{
		company: "Atlas Data Systems",
		role: "Senior Data Engineer",
		dates: "2022 — Present",
		highlights: [
			"Led migration to a lakehouse architecture with CDC ingestion and quality checks.",
			"Built multi-tenant orchestration for 200+ pipelines with SLA monitoring.",
		],
	},
	{
		company: "Vector Labs",
		role: "Backend / ML Engineer",
		dates: "2019 — 2022",
		highlights: [
			"Shipped model serving platform with canary releases and auto-scaling.",
			"Implemented feature store pipelines for real-time personalization.",
		],
	},
];
---

<Layout>
	<div class="page">
		<header class="topbar">
			<a class="brand" href="#top">
				<span class="brand-dot"></span>
				Saif Shaikh
			</a>
			<nav class="nav">
				<a href="#about">About</a>
				<a href="#work">Work</a>
				<a href="#projects">Projects</a>
				<a href="#writing">Blog</a>
			</nav>
			<div class="actions">
				<button
					class="theme-toggle"
					type="button"
					data-theme-toggle
					aria-label="Toggle theme"
				>
					<svg
						class="theme-icon"
						viewBox="0 0 64 64"
						role="img"
						aria-hidden="true"
					>
						<path
							d="M24 46h30v6H24zm30-6H40l-6-20 12-10 6 20 6-4 3 8-7 3zM14 14h10l4 6H18l-8 24h10v6H4v-6h6z"
							fill="currentColor"
						/>
					</svg>
				</button>
				<a class="cta" href="mailto:hello@saifshaikh.ca">Say Hello</a>
			</div>
		</header>

		<main id="top" class="main">
			<section class="hero reveal">
				<div class="hero-image">
					<img src="/uottawa-hero.jpg" alt="University of Ottawa - Tabaret Hall" />
					<span class="caption">Ottawa, Canada</span>
				</div>
			</section>

			<section id="about" class="section reveal delay-1">
				<div class="section-head">
					<h2>About</h2>
				</div>
				<div class="section-body">
					<p>
						I’m a data engineer focused on building large-scale pipelines, orchestration systems,
						and ML infrastructure. I care about reliability, lineage, and quality across the entire
						data lifecycle.
					</p>
					<p>
						Recent work includes lakehouse migrations, feature platform development, and backend
						services that support production ML.
					</p>
					<p class="contact">
						Reach me:
						{quickLinks.map((item) => (
							<a href={item.href} key={item.label}>
								<span class="contact-icon" aria-hidden="true">
									{item.icon === "email" && (
										<svg viewBox="0 0 24 24">
											<path
												d="M4 6h16v12H4z"
												fill="none"
												stroke="currentColor"
												stroke-width="1.5"
											/>
											<path
												d="m4 7 8 6 8-6"
												fill="none"
												stroke="currentColor"
												stroke-width="1.5"
											/>
										</svg>
									)}
									{item.icon === "github" && (
										<svg viewBox="0 0 24 24">
											<path
												d="M12 3a9 9 0 0 0-2.85 17.55c.45.08.62-.2.62-.44v-1.55c-2.54.55-3.07-1.1-3.07-1.1-.41-1.05-1-1.33-1-1.33-.82-.56.06-.55.06-.55.9.06 1.37.94 1.37.94.8 1.38 2.09.98 2.6.75.08-.6.31-.98.56-1.2-2.03-.24-4.16-1.02-4.16-4.55 0-1 .36-1.81.95-2.45-.1-.24-.41-1.2.09-2.5 0 0 .79-.26 2.6.94a8.9 8.9 0 0 1 4.74 0c1.8-1.2 2.6-.94 2.6-.94.5 1.3.19 2.26.1 2.5.59.64.94 1.45.94 2.45 0 3.54-2.14 4.31-4.18 4.54.32.28.6.83.6 1.67v2.48c0 .24.16.52.63.44A9 9 0 0 0 12 3Z"
												fill="currentColor"
											/>
										</svg>
									)}
									{item.icon === "linkedin" && (
										<svg viewBox="0 0 24 24">
											<path
												d="M6 9v9H3V9h3Zm-.2-3.1a1.8 1.8 0 1 1-3.6 0 1.8 1.8 0 0 1 3.6 0ZM21 13v5h-3v-4.3c0-1.1-.4-1.8-1.3-1.8-.7 0-1.1.5-1.3 1-.1.2-.1.5-.1.8V18h-3s0-7.3 0-8h3v1.1c.4-.7 1.1-1.6 2.7-1.6 2 0 3.4 1.3 3.4 3.5Z"
												fill="currentColor"
											/>
										</svg>
									)}
								</span>
								<span>{item.value}</span>
							</a>
						))}
					</p>
				</div>
			</section>

			<section id="work" class="section reveal delay-2">
				<div class="section-head">
					<h2>Work</h2>
				</div>
				<div class="section-body">
					{work.map((role) => (
						<article class="work-item" key={role.company}>
							<div class="work-top">
								<div>
									<h3>{role.company}</h3>
									<p>{role.role}</p>
								</div>
								<span>{role.dates}</span>
							</div>
							<ul>
								{role.highlights.map((item) => (
									<li key={item}>{item}</li>
								))}
							</ul>
						</article>
					))}
				</div>
			</section>

			<section id="projects" class="section reveal delay-3">
				<div class="section-head">
					<h2>Selected Projects</h2>
				</div>
				<div class="project-list">
					{projects.map((project) => (
						<article class="project" key={project.id}>
							<div>
								<h3>{project.data.title}</h3>
								<p>{project.data.description}</p>
								<div class="tag-row">
									{project.data.tags.map((tag) => (
										<span class="tag" key={tag}>{tag}</span>
									))}
								</div>
							</div>
							<a class="card-link" href={project.data.link ?? "#"}>View</a>
						</article>
					))}
				</div>
			</section>

			<section id="writing" class="section reveal delay-4">
				<div class="section-head">
					<h2>Blog</h2>
				</div>
				<div class="post-list">
					{posts.map((post) => (
						<a class="post" href={`/blog/${post.slug}`} key={post.id}>
							<div>
								<h3>{post.data.title}</h3>
								<span>{formatDate(post.data.date)}</span>
							</div>
							<span class="arrow">→</span>
						</a>
					))}
				</div>
			</section>
		</main>

		<footer class="footer">
			<p>© 2026 Saif Shaikh. Built with Astro and shipped from Ottawa.</p>
			<a href="#top">Back to top</a>
		</footer>
	</div>
</Layout>

<style>
	.page {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		padding: 28px clamp(20px, 4vw, 84px) 48px;
	}

	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding-bottom: 24px;
		border-bottom: 1px solid var(--stroke);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.brand-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--ink);
	}

	.nav {
		display: flex;
		gap: 18px;
		font-size: 0.95rem;
		color: var(--muted);
	}

	.nav a:hover {
		color: var(--ink);
	}

	.cta {
		padding: 10px 18px;
		border-radius: 999px;
		background: var(--ink);
		color: var(--bg);
		font-size: 0.95rem;
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.theme-toggle {
		border: 1px solid var(--stroke);
		background: transparent;
		color: var(--ink);
		width: 44px;
		height: 44px;
		padding: 0;
		border-radius: 12px;
		font-size: 0.9rem;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.theme-icon {
		width: 20px;
		height: 20px;
		display: block;
	}
	.main {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 56px;
		max-width: 900px;
		width: 100%;
		margin: 0 auto;
	}

	.hero {
		display: flex;
	}

	.hero-image {
		width: 100%;
		border-radius: 18px;
		overflow: hidden;
		background: var(--surface);
		border: 1px solid var(--stroke);
	}

	.hero-image img {
		width: 100%;
		height: auto;
		display: block;
	}

	.caption {
		display: block;
		padding: 10px 14px;
		font-size: 0.85rem;
		color: var(--muted);
		border-top: 1px solid var(--stroke);
	}

	.section {
		display: flex;
		flex-direction: column;
		gap: 16px;
		padding-top: 8px;
		border-top: 1px solid var(--stroke);
	}

	.section-head {
		max-width: 680px;
	}

	h2 {
		font-family: "Space Grotesk", "Futura", "Avenir Next", sans-serif;
		font-size: 1.3rem;
		margin: 0;
	}

	.section-head p {
		margin: 0;
		color: var(--muted);
	}

	.section-body {
		display: flex;
		flex-direction: column;
		gap: 14px;
		max-width: 720px;
		color: var(--muted);
	}

	.section-body p {
		margin: 0;
		line-height: 1.7;
	}

	.contact {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}

	.contact a {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.contact-icon {
		width: 16px;
		height: 16px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.contact-icon svg {
		width: 16px;
		height: 16px;
		display: block;
	}

	.work-item {
		padding: 18px 0;
		border-bottom: 1px solid var(--stroke);
	}

	.work-item:last-child {
		border-bottom: none;
	}

	.work-top {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		align-items: center;
	}

	.work-item h3 {
		margin: 0;
		font-size: 1.05rem;
	}

	.work-item p {
		margin: 4px 0 0;
		color: var(--muted);
	}

	.work-item span {
		color: var(--muted);
		font-size: 0.9rem;
	}

	.work-item ul {
		margin: 12px 0 0;
		padding-left: 18px;
		color: var(--muted);
		line-height: 1.6;
	}

	.project-list {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.project {
		display: flex;
		justify-content: space-between;
		gap: 24px;
		padding: 16px 0;
		border-bottom: 1px solid var(--stroke);
	}

	.project:last-child {
		border-bottom: none;
	}

	.project h3 {
		margin: 0;
		font-size: 1.05rem;
	}

	.project p {
		margin: 6px 0 10px;
		color: var(--muted);
		line-height: 1.6;
	}

	.tag-row {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.tag {
		font-size: 0.75rem;
		padding: 2px 8px;
		border: 1px solid var(--stroke);
		border-radius: 999px;
		color: var(--muted);
	}

	.card-link {
		font-weight: 500;
		color: var(--ink);
	}

	.post-list {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.post {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 14px 0;
		border: 1px solid var(--stroke);
		border-left: none;
		border-right: none;
		background: transparent;
	}

	.post h3 {
		margin: 0 0 6px;
		font-size: 1rem;
	}

	.post span {
		color: var(--muted);
		font-size: 0.9rem;
	}

	.footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding-top: 48px;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.arrow {
		font-size: 1.2rem;
		color: var(--muted);
	}

	@media (max-width: 900px) {
		.topbar {
			flex-wrap: wrap;
		}

		.actions {
			width: 100%;
			justify-content: space-between;
		}

		.project {
			flex-direction: column;
		}
	}

	@media (max-width: 640px) {
		.nav {
			width: 100%;
			justify-content: space-between;
		}

		.footer {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
