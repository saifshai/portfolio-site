---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
	const posts = await getCollection("blog");
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout>
	<div class="page">
		<header class="topbar">
			<a class="brand" href="/">
				<span class="brand-dot"></span>
				Saif Shaikh
			</a>
			<nav class="nav">
				<a href="/#about">About</a>
				<a href="/#work">Work</a>
				<a href="/#projects">Projects</a>
				<a href="/#writing">Blog</a>
			</nav>
			<div class="actions">
				<button
					class="theme-toggle"
					type="button"
					data-theme-toggle
					aria-label="Toggle theme"
				>
					<svg
						class="theme-icon"
						viewBox="0 0 64 64"
						role="img"
						aria-hidden="true"
					>
						<path
							d="M24 46h30v6H24zm30-6H40l-6-20 12-10 6 20 6-4 3 8-7 3zM14 14h10l4 6H18l-8 24h10v6H4v-6h6z"
							fill="currentColor"
						/>
					</svg>
				</button>
				<a class="cta" href="mailto:hello@saifshaikh.ca">Say Hello</a>
			</div>
		</header>

		<article class="post">
			<header>
				<h1>{post.data.title}</h1>
				<p>{post.data.date.toLocaleDateString("en-CA", { dateStyle: "medium" })}</p>
			</header>
			<Content />
		</article>
	</div>
</Layout>

<style>
	.page {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		padding: 28px clamp(20px, 4vw, 84px) 64px;
	}

	.topbar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding-bottom: 24px;
		border-bottom: 1px solid var(--stroke);
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 12px;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.brand-dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--ink);
	}

	.nav {
		display: flex;
		gap: 18px;
		font-size: 0.95rem;
		color: var(--muted);
	}

	.nav a:hover {
		color: var(--ink);
	}

	.cta {
		padding: 10px 18px;
		border-radius: 999px;
		background: var(--ink);
		color: var(--bg);
		font-size: 0.95rem;
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.theme-toggle {
		border: 1px solid var(--stroke);
		background: transparent;
		color: var(--ink);
		width: 44px;
		height: 44px;
		padding: 0;
		border-radius: 12px;
		font-size: 0.9rem;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.theme-icon {
		width: 20px;
		height: 20px;
		display: block;
	}

	.post {
		max-width: 720px;
		margin: 0 auto;
		padding-top: 48px;
	}

	h1 {
		font-size: 2rem;
		margin: 0 0 12px;
	}

	header p {
		margin: 0 0 24px;
		color: var(--muted);
	}

	:global(.post p) {
		line-height: 1.7;
		color: var(--muted);
	}

	@media (max-width: 900px) {
		.topbar {
			flex-wrap: wrap;
		}

		.actions {
			width: 100%;
			justify-content: space-between;
		}
	}

	@media (max-width: 640px) {
		.nav {
			width: 100%;
			justify-content: space-between;
		}
	}
</style>
